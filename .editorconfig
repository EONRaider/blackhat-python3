# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml,cff}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Book code and sample data keep their original formatting; editors must not
# rewrite whitespace or line endings when a listing is touched.
[chapter*/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
